DB_HOST=postgres
DB_PORT=5432
DB_NAME=orders
DB_USER=postgres
DB_PASSWORD=postgres

# Rate limiting (shared across tasks when backed by Redis)
RATE_LIMIT=10/minute
RATE_LIMIT_STORAGE_URI=redis://redis:6379/0

# Connection pool (per process). 0 disables pooling.
DB_POOL_MAX=10
DB_POOL_TIMEOUT=5
DB_POOL_PING_AFTER=1

# Idempotency keys expire after this; cleanup runs this often (0 = off)
IDEMPOTENCY_TTL_HOURS=24
IDEMPOTENCY_CLEANUP_INTERVAL_SECONDS=3600
